NODE_ENV=test

# Committed on purpose: contains no real secrets. The database name MUST end in
# "_test" (test/env.ts refuses to run otherwise) and the JWT secret is an obvious
# dummy. The @ in the local Postgres password is percent-encoded (%40) so the URL
# parses cleanly.
DATABASE_URL="postgresql://admin:p%40ss%40dmin@localhost:5432/payments_system_test?schema=public"
JWT_SECRET=use-your-test-jwt-secret
