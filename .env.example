PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-secret-here-min-32-chars
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payments

# The mock bank's own Postgres (docker-compose service `bank`, host port 5433)
POSTGRES_USER_BANK=postgres
POSTGRES_PASSWORD_BANK=postgres
POSTGRES_DB_BANK=mock_bank
